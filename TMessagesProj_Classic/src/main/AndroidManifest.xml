<?xml version="1.0" encoding="utf-8"?>
<!-- MurkaGram: dual UI. Activities of the classic 12.2.10 UI. They are not exported and have no intent filters: the system
     (launcher icons, shortcuts, share sheet, links) always talks to the modern org.telegram.ui.* activities, which hand the
     intent over to these ones when the classic edition is active (UiEdition / UiBridge.component). Attributes as the modern
     originals in TMessagesProj/src/main/AndroidManifest.xml. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <activity
            android:name="org.telegram.classic.ui.LaunchActivity"
            android:theme="@style/Theme.TMessages.Start"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|uiMode|smallestScreenSize|screenLayout"
            android:supportsPictureInPicture="true"
            android:hardwareAccelerated="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:exported="false" />
        <activity
            android:name="org.telegram.classic.ui.BubbleActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|uiMode|smallestScreenSize|screenLayout"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize"
            android:allowEmbedded="true"
            android:documentLaunchMode="always"
            android:resizeableActivity="true"
            android:exported="false" />
        <activity
            android:name="org.telegram.classic.ui.ShareActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustPan"
            android:excludeFromRecents="true"
            android:stateNotNeeded="true"
            android:theme="@style/Theme.TMessages.Transparent"
            android:exported="false" />
        <activity
            android:name="org.telegram.classic.ui.ExternalActionActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustPan"
            android:exported="false" />
        <activity
            android:name="org.telegram.classic.ui.PopupNotificationActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|uiMode|screenSize|smallestScreenSize"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:theme="@style/Theme.TMessages.PopupNotification"
            android:resizeableActivity="false"
            android:windowSoftInputMode="adjustResize|stateHidden"
            android:exported="false" />
    </application>
</manifest>
